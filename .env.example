#
# PANDUAN:
# 1. Salin file ini: cp .env.example .env
# 2. Isi semua nilai yang diperlukan di file .env
# 3. JANGAN pernah commit file .env ke repositori!
# =======================================================================

# ─── Branding ─────────────────────────────────────────────────────────
# Nama satuan kerja yang akan ditampilkan di navbar aplikasi
SATKER_NAME=Nama Satuan Kerja Anda

# ─── Django Core ──────────────────────────────────────────────────────
# Buat secret key yang unik dan panjang (min. 50 karakter acak)
# Generator: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=ganti-dengan-secret-key-yang-sangat-panjang-dan-acak

# Set ke False di lingkungan produksi!
DEBUG=True

# Daftar host yang diizinkan (pisahkan dengan koma)
# Contoh produksi: mydomain.com,www.mydomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Untuk keamanan CSRF di produksi (sesuaikan dengan domain Anda)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Superuser Awal (opsional, hanya untuk entrypoint Docker) ─────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ganti-password-ini
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ─── Database ─────────────────────────────────────────────────────────
# Jika tidak diisi, Django akan menggunakan SQLite secara default.
# Format PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://pikas_user:password@localhost:5432/pikas_db

# ─── Google API Credentials ───────────────────────────────────────────
# Pilih salah satu metode autentikasi berikut:

# Metode 1 (Disarankan untuk produksi):
# Salin seluruh konten file JSON Service Account ke variabel ini.
# Pastikan disimpan dalam satu baris tanpa baris baru.
GOOGLE_SERVICE_ACCOUNT_JSON={}

# Metode 2 (Untuk pengembangan lokal):
# Tentukan path file JSON Service Account di sistem Anda.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json
