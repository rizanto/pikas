# ─── Django ───────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
static_collected/
staticfiles/

# ─── SENSITIF — Jangan pernah commit file ini ─────────
.env
service_account.json
*.json.bak

# ─── Data mapping produksi (simpan di luar repo) ──────
# Uncomment baris di bawah jika ingin exclude file ini:
# mapping.json
# ro-mapping.json

# ─── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual Environments ─────────────────────────────
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ─── OS Files ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── File Sementara ───────────────────────────────────
*.tmp
*.bak
append_views.py
extract.py
developer_guide.md